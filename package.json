	"repository": "https://github.com/mulingyuer/Typecho_Theme_JJ.git",
	"main": "index.js",
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build && bumpp --no-commit --no-tag --no-push && ts-node -P buildCommand/tsconfig.json buildCommand/updateVersion.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --write --ignore-path=.oxfmtignore .",
		"format:check": "oxfmt --check --ignore-path=.oxfmtignore .",
		"build-zip": "ts-node -P buildCommand/tsconfig.json buildCommand/zip.ts"
	},
	"dependencies": {
		"@docsearch/css": "3.6.1",
		"@docsearch/js": "3.6.1",
		"@floating-ui/dom": "^1.6.10",
		"axios": "^1.6.8",
		"highlight.js": "^11.10.0",
		"mitt": "^3.0.1",
		"pinia": "^2.2.2",
		"qrcode": "^1.5.4",
		"simplebar": "^6.2.7",
		"toastify-js": "^1.12.0",
		"vue": "^3.5.3"
	},
	"devDependencies": {
		"@types/archiver": "^6.0.2",
		"@types/node": "^22.5.4",
		"@types/qrcode": "^1.5.5",
		"@types/toastify-js": "^1.12.4",
		"archiver": "^7.0.1",
		"autoprefixer": "^10.4.20",
		"bumpp": "^9.5.2",
		"glob": "^11.0.0",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"postcss": "^8.4.45",
		"sass-embedded": "^1.104.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.5.4",
		"vite": "^8.3.0"
	},
	"packageManager": "pnpm@12.5.1"
}