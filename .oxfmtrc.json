{
	"printWidth": 120,
	"tabWidth": 2,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "none",
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"ignorePatterns": [
		"dist/",
		"node_modules/",
		"public/",
		"docker/mysql-data/",
		"docker/backup/",
		"docker/plugins/",
		"php_modules/",
		"pnpm-lock.yaml",
		".git/",
		".husky/"
	]
}