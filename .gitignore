node_modules
/dist
/Typecho_Theme_JJ.zip

# 本地开发环境：docker-compose.yml 和 README.md 入库共享，
# 只忽略本地生成的内容和敏感信息
docker/mysql-data/
docker/mysql-data-*/
docker/sqlite-data/
docker/pgsql-data/
docker/config.inc.php
docker/plugins/*
!docker/plugins/.gitkeep
!docker/backup

# 主题产物镜像同步目录（构建后自动从 dist 同步，不入库）
docker/themes/*
!docker/themes/.gitkeep

# 本地 HTTPS 证书（mkcert 生成，私钥不入库）
docker/certs/*.pem
docker/certs/*.key