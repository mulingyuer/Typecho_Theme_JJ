{
	"compilerOptions": {
		/* Visit https://aka.ms/tsconfig.json to read more about this file */
		/* 语言与环境 */
		"target": "ES2015" /* 设置编译输出的 JavaScript 语言版本，并包含兼容的库声明 */,
		/* 模块 */
		"module": "ESNext" /* 指定生成的模块代码格式 */,
		"moduleResolution": "Bundler" /* 指定 TypeScript 如何从给定的模块说明符查找文件 */,
		"paths": {
			"@/*": [
				"./src/*"
			]
		} /* 指定将导入路径重新映射到其他查找位置的一组条目 */,
		"types": [
			"vite/client"
		] /* 指定无需在源文件中引用即可包含的类型包名称 */,
		"resolveJsonModule": true /* 允许导入 .json 文件 */,
		/* 互操作约束 */
		"allowSyntheticDefaultImports": true /* 当模块没有默认导出时，允许 'import x from y' 这种导入方式 */,
		"esModuleInterop": true /* 生成额外的 JavaScript 代码以简化对 CommonJS 模块的导入支持，并为类型兼容性启用 allowSyntheticDefaultImports */,
		"forceConsistentCasingInFileNames": true /* 确保导入的文件名大小写一致 */,
		/* 类型检查 */
		"strict": true /* 启用所有严格的类型检查选项 */,
		"noImplicitThis": false /* 关闭当 `this` 被推断为 `any` 类型时的错误提示 */,
		/* 完整性 */
		"skipLibCheck": true /* 跳过对所有 .d.ts 文件的类型检查 */
	},
	"include": [
		"src/**/*",
		"vite.config.ts",
		"vite/**/*"
	],
	"exclude": [
		"node_modules"
	]
}